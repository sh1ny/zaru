{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": ["mcp-server", "--enable=run_tests,dart_format,dart_fix"],
      "env": {
        "DART_DATA_HOME": ".dart_tool/dart-data"
      }
    }
  }
}
